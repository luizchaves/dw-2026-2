# Ambiente de teste.
#
# Versionado de propósito: não há segredo aqui, e a suíte precisa do mesmo
# ambiente em qualquer máquina. O banco é outro arquivo, recriado do zero a
# cada `npm test` — nenhum teste apaga o banco de desenvolvimento.
DATABASE_URL="file:./prisma/db.test.sqlite"
JWT_SECRET="segredo-de-teste"
JWT_EXPIRES_IN=3600
# O agendador não sobe nos testes, mas a variável fica explícita.
MONITOR_ENABLED=false
