# Modelo do `.env`, que é ignorado pelo Git. Comece com:
#
#   cp .env.example .env
#
# O mesmo arquivo serve para rodar na máquina (`npm run dev`) e em container:
# o `compose.yaml` da pasta acima o lê e repassa as variáveis ao processo, sem
# que elas entrem na imagem.

# Caminho do banco SQLite. Em container o Compose troca por
# `file:/app/data/db.sqlite`, que é onde o volume está montado.
DATABASE_URL="file:./prisma/db.sqlite"

# A chave que assina os tokens. Qualquer um que a tenha consegue forjar um
# token válido: em produção, um valor longo e aleatório, e nunca no Git.
JWT_SECRET="segredo-de-desenvolvimento"
JWT_EXPIRES_IN=3600

MONITOR_ENABLED=true
MONITOR_INTERVAL=60

# Origem do front-end. `*` em desenvolvimento; a origem exata em produção.
ALLOWED_ORIGIN="*"
