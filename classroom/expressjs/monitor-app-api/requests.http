@host = http://localhost:3000/api
@createdHostId = {{createdHost.response.body.$.id}}
@createdTagId = {{createdTag.response.body.$.id}}

### Create Host

# @name createdHost
POST {{host}}/hosts
Content-Type: application/json

{
  "name": "Google DNS",
  "address": "8.8.8.8",
  "tags": ["infra", "dns"]
}

### Create Host without tags

POST {{host}}/hosts
Content-Type: application/json

{
  "name": "Cloudflare DNS",
  "address": "1.1.1.1"
}

### Create Host without address

POST {{host}}/hosts
Content-Type: application/json

{
  "name": "Google DNS"
}

### Create Host without body

POST {{host}}/hosts

### Read Hosts

GET {{host}}/hosts

### Read Hosts by id

GET {{host}}/hosts/{{createdHostId}}

### Read Hosts by invalid id

GET {{host}}/hosts/a

### Read Hosts by name

GET {{host}}/hosts?name=Google

### Read Hosts by tag

GET {{host}}/hosts?tag=dns

### Read Hosts by name and tag

GET {{host}}/hosts?name=Google&tag=dns

### Update Host

PUT {{host}}/hosts/{{createdHostId}}
Content-Type: application/json

{
  "name": "Google Public DNS",
  "address": "8.8.4.4",
  "tags": ["dns"]
}

### Update Host without address

PUT {{host}}/hosts/{{createdHostId}}
Content-Type: application/json

{
  "name": "Google Public DNS"
}

### Update Host with invalid id

PUT {{host}}/hosts/a
Content-Type: application/json

{
  "name": "Google Public DNS",
  "address": "8.8.4.4"
}

### Read Pings by Host

GET {{host}}/hosts/{{createdHostId}}/pings

### Read Pings by invalid Host

GET {{host}}/hosts/a/pings

### Create Tag

# @name createdTag
POST {{host}}/tags
Content-Type: application/json

{
  "name": "backup",
  "color": "#ef4444"
}

### Create Tag already registered

POST {{host}}/tags
Content-Type: application/json

{
  "name": "backup",
  "color": "#ef4444"
}

### Create Tag without color

POST {{host}}/tags
Content-Type: application/json

{
  "name": "backup"
}

### Read Tags

GET {{host}}/tags

### Read Tags by name

GET {{host}}/tags?name=pro

### Read Tags by id

GET {{host}}/tags/{{createdTagId}}

### Read Tags by invalid id

GET {{host}}/tags/a

### Delete Host

DELETE {{host}}/hosts/{{createdHostId}}

### Delete Host with invalid id

DELETE {{host}}/hosts/a
